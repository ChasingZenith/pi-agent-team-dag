# ─────────────────────────────────────────────
#  Pi Agent — Provider API Keys Sample
#  Copy to .env and fill in your keys
#  Usage: source .env && pi
# ─────────────────────────────────────────────



# ─────────────────────────────────────────────
#  comms — NATS + JetStream Pi-to-Pi communication
#  Only needed when running the comms extension or server.
# ─────────────────────────────────────────────

# Shared NATS auth token. For 127.0.0.1-only operation the server
# (scripts/comms-nats/up.sh) auto-generates a token and writes it to
# ~/.pi/comms/server.secret.json (chmod 0600).
# Set this to a long random string (e.g. `openssl rand -hex 32`) before
# exposing the hub beyond localhost.
PI_COMMS_AUTH_TOKEN=

# NATS server port (default 4222). Pin it to keep the URL stable.
PI_COMMS_PORT=

# NATS server URL for clients. Leave blank for nats://127.0.0.1:4222.
# Set to e.g. nats://192.168.1.100:4222 when connecting to a remote server.
PI_COMMS_NATS_URL=

# NATS 服务器绑定地址(默认 127.0.0.1)。暴露到 loopback 之外必须显式设置
# PI_COMMS_AUTH_TOKEN,否则 up.sh 拒绝启动。
PI_COMMS_HOST=

# 心跳间隔毫秒数(默认 10000 = 10s)。每次心跳刷新注册表卡片 TTL(滑动租约)。
PI_COMMS_HEARTBEAT_MS=

# 消息 TTL / ack_wait 毫秒数(默认 1800000 = 30 分钟)。离线期间的消息在
# stream 中排队,超过此年龄被清理。
PI_COMMS_MESSAGE_TTL_MS=

# 注册表租约 TTL 毫秒数(默认 30000 = 30s)。心跳滑动续约;租约过期即从
# 注册表消失。
PI_COMMS_REGISTRY_TTL_MS=

# 心跳超过多久标记为 stale(默认 30000 = 30s)。
PI_COMMS_STALE_AFTER_MS=

# 心跳超过多久标记为 offline 并在本地缓存裁剪(默认 60000 = 60s)。
PI_COMMS_OFFLINE_AFTER_MS=

# 固定 scripts/comms-nats/up.sh 下载的 nats-server 版本(默认 2.14.4,
# 用于 SHA256 校验的 release 标签)。
PI_COMMS_NATS_VERSION=
